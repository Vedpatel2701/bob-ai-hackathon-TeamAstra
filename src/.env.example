# Copy this file to .env and fill in your actual values
# NEVER commit the .env file — it is in .gitignore

# Application
APP_PORT=8000
APP_ENV=development

# Model and data paths (leave empty to use auto-detected defaults)
MODEL_PATH=
DATA_PATH=

# Frontend API URL (for Docker/production deployment)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# IBM watsonx.ai (optional — MVP runs without these)
WATSONX_API_KEY=your_api_key_here
WATSONX_PROJECT_ID=your_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
